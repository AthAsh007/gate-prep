---
import "../styles/global.css";
import { EXAM_DATE, EXAM_LABEL } from "../config";

interface Props {
  title: string;
  description?: string;
  bare?: boolean;
}
const { title, description = "GATE 2027 CS study notes and timed mock tests.", bare = false } = Astro.props;
const fullTitle = title === "GATE 2027 CS Prep" ? title : `${title} | GATE 2027 CS Prep`;
const path = Astro.url.pathname;
const current = (p: string) => (path.startsWith(p) ? "page" : undefined);
const canonical = new URL(path, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1014" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="author" href="https://athash.in/" />
    <meta name="author" content="Atharva Ashtekar" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GATE 2027 CS Prep" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/" aria-label="GATE CS 2027 home">
          <span class="brand-mark" aria-hidden="true">G</span>
          <span class="brand-name">GATE CS <span>2027</span></span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/notes/" aria-current={current("/notes")}>Notes</a>
          <a href="/sheets/" aria-current={current("/sheets")}>Sheets</a>
          <a href="/tests/" aria-current={current("/tests")}>Tests</a>
          <a href="/plan/" aria-current={current("/plan")}>Plan</a>
        </nav>
        <div class="countdown" id="countdown" data-target={EXAM_DATE} title={`${EXAM_LABEL} ${new Date(EXAM_DATE).toDateString()}`}>
          <span class="countdown-dot" aria-hidden="true"></span>
          <span class="countdown-label">{EXAM_LABEL} in</span>
          <span class="countdown-value" data-countdown="full">--</span>
        </div>
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch light or dark theme">
          <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
          <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </header>
    <main class={bare ? "" : "wrap main"}>
      <slot />
    </main>
    {!bare && (
      <footer class="site-footer">
        <div class="wrap footer-row">
          <p>Syllabus: GATE 2027 CS, IIT Madras. The countdown targets the first exam day; check gate2027.iitm.ac.in for the CS paper's date and session. Not affiliated with IIT Madras or the GATE organising committee.</p>
          <nav class="footer-links" aria-label="Footer">
            <a href="/plan/">Study plan</a>
            <a href="/sheets/">Formula sheets</a>
            <a href="/about/">About</a>
            <a href="/privacy/">Privacy</a>
            <a href="/disclaimer/">Disclaimer</a>
            <a href="/terms/">Terms</a>
            <a href="https://athash.in/" rel="author">Made by Atharva Ashtekar</a>
          </nav>
        </div>
      </footer>
    )}
    <script>
      import { EXAM_DATE } from "../config";
      import { doneKeys } from "../scripts/progress";

      const done = new Set(doneKeys());
      document.querySelectorAll<HTMLElement>("[data-topic]").forEach((el) => {
        if (!done.has(el.dataset.topic!)) return;
        el.classList.add("is-done");
        const status = el.querySelector("[data-status]");
        if (status) status.textContent = "Done ✓";
      });
      document.querySelectorAll<HTMLElement>("[data-section-progress]").forEach((el) => {
        const slug = el.dataset.sectionProgress!;
        const total = Number(el.dataset.total);
        const n = [...done].filter((k) => k.startsWith(`${slug}/`)).length;
        el.querySelector<HTMLElement>("i")!.style.width = `${(n / total) * 100}%`;
        el.querySelector("span")!.textContent = `${n} of ${total} topics done`;
      });
      const target = new Date(EXAM_DATE).getTime();
      const pad = (n: number) => String(n).padStart(2, "0");
      function tick() {
        const ms = Math.max(0, target - Date.now());
        const s = Math.floor(ms / 1000);
        const parts = {
          d: Math.floor(s / 86400),
          h: Math.floor((s % 86400) / 3600),
          m: Math.floor((s % 3600) / 60),
          s: s % 60,
        };
        document.querySelectorAll<HTMLElement>("[data-countdown]").forEach((el) => {
          const k = el.dataset.countdown!;
          if (k === "full") el.textContent = ms ? `${parts.d}d ${pad(parts.h)}:${pad(parts.m)}:${pad(parts.s)}` : "exam day";
          else el.textContent = k === "d" ? String(parts[k]) : pad(parts[k as "h" | "m" | "s"]);
        });
      }
      tick();
      setInterval(tick, 1000);

      if ("serviceWorker" in navigator && location.hostname !== "localhost") {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }

      document.getElementById("theme-toggle")!.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {}
      });
    </script>
  </body>
</html>
